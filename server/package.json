{
  "name": "roamio-server",
  "version": "1.0.0",
  "description": "Roamio API: a grounded, budget-aware GenAI trip planner (RAG + tool calling + validated structured output)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
