# --- AI (leave GEMINI_API_KEY empty to run the offline mock model) ---
GEMINI_API_KEY=
# Model ids change over time. Check https://ai.google.dev/gemini-api/docs/models and override if needed.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Free-tier keys allow only a few requests per minute. Set this to your limit (0 = unlimited).
LLM_RPM=8
# Optional speed knob: MINIMAL | LOW | MEDIUM | HIGH
# LLM_THINKING_LEVEL=LOW
# Optional cost reporting (USD per 1M tokens) for the "estimated cost" figure
# LLM_PRICE_IN_PER_M=0.30
# LLM_PRICE_OUT_PER_M=2.50
LLM_MAX_CALLS_PER_DAY=1500

# --- App ---
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated allowed browser origins (only needed when the client is hosted separately)
CLIENT_ORIGIN=http://localhost:5173
# Leave empty to keep accounts and trips in memory (lost on restart)
MONGODB_URI=
